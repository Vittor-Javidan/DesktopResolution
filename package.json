{
  "name": "desktop-frame-rate-app",
  "version": "1.1.0",
  "private": true,
  "description": "Windows tray app for changing display resolutions and refresh rates",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --win nsis",
    "unregister:context-menu": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/unregister-context-menu.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.vittor.desktopframerateapp",
    "productName": "Desktop Frame Rate App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/display-refresh.ps1",
        "to": "display-refresh.ps1"
      },
      {
        "from": "scripts/unregister-context-menu.ps1",
        "to": "unregister-context-menu.ps1"
      },
      {
        "from": "assets/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
